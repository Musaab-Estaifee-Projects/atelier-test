# NEXT_PUBLIC_BASE_URL=

# NEXT_PUBLIC_SHOW_DEV_TOOLS=

# Only one browser tab may open a stream for the same stream, project, and layout.
# Unset or false keeps the current behavior (no tab lock).
# NEXT_PUBLIC_SINGLE_TAB_STREAM=false

# Unreal command log. Unset or false: development only. true: also show in production.
# NEXT_PUBLIC_SHOW_UE_LOG=false

# Seconds of no input before the AFK warning. Default 600 (10 min).
# NEXT_PUBLIC_STREAM_AFK_TIMEOUT=600

# Seconds shown on the AFK warning countdown. Default 60.
# NEXT_PUBLIC_STREAM_AFK_WARNING=60